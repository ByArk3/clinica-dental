# Copiar a .env y ajustar
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinica_dental?schema=public"
PORT=3000
SESSION_SECRET="cambie-esto-por-un-secreto-largo"
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development
TZ=America/Lima
# Correo (Mailtrap / Ethereal en desarrollo). Si SMTP_HOST está vacío, los correos se muestran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clínica Dental <no-responder@clinica.local>"
# Tareas programadas (recordatorio 48 h, liberación 24 h)
JOBS_ENABLED=true
