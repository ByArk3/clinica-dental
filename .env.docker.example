# Copiar a .env (en la raíz) para personalizar docker compose. Todo es opcional.
DB_PASSWORD=clinica
SESSION_SECRET=cambie-este-secreto-en-produccion
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
# true en producción con HTTPS
COOKIE_SECURE=false
# Cargar datos de ejemplo al iniciar (usuarios de prueba con contraseña Clinica2026). Poner false en producción.
SEED=true
# Correo (vacío = los correos solo se registran en el log de la API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
