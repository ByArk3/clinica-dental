# Copiar a .env (en la raíz) para personalizar docker compose. Todo es opcional.
DB_PASSWORD=clinica
# Secreto de las sesiones: un valor aleatorio de 32+ caracteres. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vacío = se genera uno temporal en cada arranque.
SESSION_SECRET=
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
# true en producción con HTTPS
COOKIE_SECURE=false
# Cargar datos de ejemplo al iniciar (usuarios de prueba con contraseña Clinica2026). Poner false en producción.
SEED=true
# Correo (vacío = los correos solo se registran en el log de la API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clínica Dental <no-responder@clinica.local>
# Autocompletar nombres con el DNI en Nueva cita (opcional). Token de un proveedor de consultas RENIEC
# (por defecto Decolecta: https://decolecta.com). Vacío = la recepcionista escribe los datos.
RENIEC_TOKEN=
# URL del proveedor con {dni} donde va el número (vacío = Decolecta)
RENIEC_URL=
# URL de la consulta de RUC (SUNAT) del mismo proveedor y token (vacío = Decolecta). Autocompleta la razón social de proveedores
SUNAT_URL=
